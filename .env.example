# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SERVE_MEDIA=0
PORT=5000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# URLs publicas usadas en links enviados por mail/WhatsApp.
PANEL_PUBLIC_BASE_URL=
ANESTHESIA_INFO_URL=
ANESTHESIA_PDF_PATH=media/anestesia/consentimiento_anestesia.pdf

# WhatsApp automatico sin QR: usar WhatsApp Cloud API / Meta.
# Requiere un numero de WhatsApp Business configurado en Meta.
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_TIMEOUT=20
# Opcional: template aprobado para conversaciones iniciadas por la empresa.
# Si queda vacio, intenta enviar mensaje libre + documento, que puede fallar fuera de ventana de 24h.
WHATSAPP_TRACKING_TEMPLATE_NAME=
WHATSAPP_TRACKING_TEMPLATE_LANGUAGE=es_AR

# Base de datos
# Opcion recomendada en servidor: DATABASE_URL=postgres://usuario:clave@host:5432/panel_ova
# Si DATABASE_URL queda vacio, se usan POSTGRES_*; si tambien quedan vacias, Django usa db.sqlite3 local.
DATABASE_URL=
POSTGRES_DB=panel_ova
POSTGRES_USER=panel_ova_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Credenciales CEMIC Quirófanos
# Opción 1: Variables compatibles con script original
CEMIC_USER=
CEMIC_PASS=
CEMIC_HEADLESS=1

# Opción 2: Variables alternativas (cualquiera de las dos funciona)
# QR_REPORT_USER=
# QR_REPORT_PASSWORD=
# QR_PLAYWRIGHT_HEADLESS=1

# URL de login (opcional, tiene default)
# CEMIC_LOGIN_URL=http://quirofanos.cemic.edu.ar/login.php

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
PATIENT_TRACKING_FROM_EMAIL=
ANESTHESIA_CONTACT_EMAIL=

# Email alternativo para admision. Dejar vacio para reutilizar EMAIL_*.
ADMISSION_EMAIL_BACKEND=
ADMISSION_EMAIL_HOST=
ADMISSION_EMAIL_PORT=
ADMISSION_EMAIL_HOST_USER=
ADMISSION_EMAIL_HOST_PASSWORD=
ADMISSION_EMAIL_USE_TLS=
ADMISSION_EMAIL_USE_SSL=
ADMISSION_EMAIL_TIMEOUT=
ADMISSION_DEFAULT_FROM_EMAIL=

# Agenda de quirofanos
AUTO_REFRESH_AGENDAS=True
AUTO_REFRESH_AGENDAS_INTERVAL_MINUTES=20
AGENDA_REFRESH_INTERVAL_MINUTES=20

# Media files
MEDIA_ROOT=media/
MEDIA_URL=/media/

# Static files
STATIC_ROOT=staticfiles/
STATIC_URL=/static/

# Logs
SLOW_QUERY_THRESHOLD=0.05
SLOW_QUERY_LOG_PATH=slow_queries.log
