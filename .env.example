# Django Settings
SECRET_KEY=tu-secret-key-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# URL publica usada en links enviados por mail/WhatsApp. Dejar vacio para usar el host del request.
PANEL_PUBLIC_BASE_URL=http://panel.oficinavirtualcemic.com
# Link de dudas frecuentes sobre anestesia enviado al paciente.
ANESTHESIA_INFO_URL=https://cemic-faq.netlify.app
# PDF de consentimiento de anestesia para adjuntar al mail del paciente.
ANESTHESIA_PDF_PATH=media/anestesia/consentimiento_anestesia.pdf

# WhatsApp automatico sin QR: usar WhatsApp Cloud API / Meta.
# Requiere un numero de WhatsApp Business configurado en Meta.
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_TIMEOUT=20
# Opcional: template aprobado para conversaciones iniciadas por la empresa.
# Si queda vacio, intenta enviar mensaje libre + documento, que puede fallar fuera de ventana de 24h.
WHATSAPP_TRACKING_TEMPLATE_NAME=
WHATSAPP_TRACKING_TEMPLATE_LANGUAGE=es_AR

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Credenciales CEMIC Quirófanos
# Opción 1: Variables compatibles con script original
CEMIC_USER=tu-usuario-cemic
CEMIC_PASS=tu-clave-cemic
CEMIC_HEADLESS=1

# Opción 2: Variables alternativas (cualquiera de las dos funciona)
# QR_REPORT_USER=tu-usuario-cemic
# QR_REPORT_PASSWORD=tu-clave-cemic
# QR_PLAYWRIGHT_HEADLESS=1

# URL de login (opcional, tiene default)
# CEMIC_LOGIN_URL=http://quirofanos.cemic.edu.ar/login.php

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=oficinavirtualdeautorizaciones@cemic.edu.ar
EMAIL_HOST_PASSWORD=tu-app-password-gmail
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=oficinavirtualdeautorizaciones@cemic.edu.ar
SERVER_EMAIL=oficinavirtualdeautorizaciones@cemic.edu.ar
PATIENT_TRACKING_FROM_EMAIL=oficinavirtualdeautorizaciones@cemic.edu.ar
PATIENT_TRACKING_BCC_EMAILS=consultorioanestesia@cemic.edu.ar

# Media files
MEDIA_ROOT=media/
MEDIA_URL=/media/

# Static files
STATIC_ROOT=staticfiles/
STATIC_URL=/static/
